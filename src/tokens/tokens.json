{
  "$description": "Follow the Money design tokens. Source of truth for colour, type, radius, shadow and blur. tokens.css mirrors these as CSS variables.",
  "color": {
    "ink": {
      "value": "#14233a",
      "use": "Primary text, icons, outlines"
    },
    "ink-soft": {
      "value": "#2d3e57",
      "use": "Body text on glass"
    },
    "muted": {
      "value": "#6a7a94",
      "use": "Secondary text, captions"
    },
    "accent": {
      "value": "#3d8bff",
      "use": "Primary actions, focus, progress"
    },
    "accent-strong": {
      "value": "#2a6fe0",
      "use": "Pressed and hover states of accent, eyebrows"
    },
    "accent-soft": {
      "value": "#d9ebff",
      "use": "Selected backgrounds"
    },
    "mint": {
      "value": "#3ddc97",
      "use": "Approve, correct, online"
    },
    "mint-strong": {
      "value": "#1fa873",
      "use": "Mint pressed edge"
    },
    "coral": {
      "value": "#ff8a7a",
      "use": "Flag, warnings, wrong answers"
    },
    "coral-strong": {
      "value": "#d8634f",
      "use": "Coral pressed edge"
    },
    "freeze": {
      "value": "#5b93f0",
      "use": "Freeze decision only"
    },
    "freeze-strong": {
      "value": "#3a6fcc",
      "use": "Freeze pressed edge"
    },
    "danger": {
      "value": "#e8574b",
      "use": "Destructive actions (end training)"
    },
    "surface": {
      "value": "#dde8f2",
      "use": "Page background behind glass"
    }
  },
  "glass": {
    "fill": {
      "value": "linear-gradient(180deg, rgba(255,255,255,0.78), rgba(235,243,255,0.62))"
    },
    "border": {
      "value": "1.5px solid rgba(255,255,255,0.9)"
    },
    "blur": {
      "value": "blur(22px) saturate(1.4)"
    },
    "fallback": {
      "value": "#f4f8fd",
      "use": "Solid fill when blur is off (low-quality mode, reduced transparency)"
    }
  },
  "font": {
    "family": {
      "value": "Inter, system-ui, sans-serif"
    },
    "weight": {
      "body": 450,
      "ui": 600,
      "strong": 650,
      "subtitle": 700,
      "title": 800
    },
    "size": {
      "caption": "12px",
      "small": "13.5px",
      "body": "15px",
      "lead": "18px",
      "h3": "20px",
      "h2": "26px",
      "display": "52px"
    },
    "eyebrow": {
      "value": "11.5px / 650 / 0.1em / uppercase"
    }
  },
  "radius": {
    "sm": "10px",
    "md": "14px",
    "lg": "18px",
    "xl": "22px",
    "xxl": "30px",
    "pill": "999px"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "7": "28px"
  },
  "shadow": {
    "card": {
      "value": "0 1px 0 rgba(255,255,255,0.9) inset, 0 24px 60px rgba(20,35,58,0.22)"
    },
    "float": {
      "value": "0 8px 24px rgba(20,35,58,0.16)"
    },
    "accent": {
      "value": "0 1px 0 rgba(255,255,255,0.45) inset, 0 8px 22px rgba(42,111,224,0.35)"
    }
  },
  "motion": {
    "press": "120ms",
    "fade": "250ms",
    "pop": "700ms cubic-bezier(.2,1.2,.4,1)"
  },
  "shade": {
    "$description": "Gradient highlights, pressed edges and text-on-tint shades. Only these raw hex values may appear in component CSS (checked by tests/tokens.test.js).",
    "white": "#ffffff",
    "white-short": "#fff",
    "accent-highlight": "#5aa0ff",
    "accent-hover-top": "#6eabff",
    "accent-hover-bottom": "#3a7cec",
    "accent-pill-top": "#6eafff",
    "accent-pill-edge": "#1f56b5",
    "accent-glow": "#8ec0ff",
    "accent-pressed-bg": "#e6f1ff",
    "mint-highlight": "#9ff5cf",
    "mint-text": "#0d3d2a",
    "coral-highlight": "#ffd9d3",
    "coral-mid": "#ffb2a6",
    "coral-text": "#7a2418",
    "coral-text-strong": "#8a2a1e",
    "coral-label": "#b23a2b",
    "coral-bg": "#fff0ee",
    "danger-highlight": "#ff8d84",
    "neutral-edge": "#c4cddd",
    "neutral-press": "#cad6ea",
    "neutral-key": "#d5deec",
    "neutral-fill": "#e6ecf6",
    "progress-label": "#4a5b78"
  }
}